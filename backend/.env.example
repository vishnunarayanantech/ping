# Copy this file to .env and adjust as needed. .env itself is gitignored.

# SQLite (default, used for development):
DATABASE_URL=sqlite:///./ping.db

# PostgreSQL (production example — also install psycopg2-binary):
# DATABASE_URL=postgresql://user:password@host:5432/ping

# Signs and verifies JWT access tokens. security.py falls back to an
# insecure dev default if this is unset — ALWAYS set a real random value
# here for any shared or production environment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Where uploaded files are stored (defaults to backend/uploads/, outside the
# frontend/static source tree). Never served directly — always read back
# through the authenticated /messages/files/{id}/download endpoint.
# UPLOAD_DIR=/var/lib/ping/uploads

# Max size, in MB, for a single file upload. Enforced against bytes actually
# streamed to disk, not just the client's claimed Content-Length.
# MAX_UPLOAD_SIZE_MB=25

# Comma-separated file extensions rejected outright, regardless of the
# client's claimed MIME type. Uncomment to override the built-in default
# (executable/script extensions) — see backend/config.py.
# BLOCKED_UPLOAD_EXTENSIONS=.exe,.dll,.bat,.cmd,.sh,.php,.py
